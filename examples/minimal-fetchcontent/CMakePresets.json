{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "win-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "win-arm64-base",
      "hidden": true,
      "inherits": "win-base",
      "architecture": "ARM64"
    },
    {
      "name": "win-arm64-static",
      "inherits": "win-arm64-base",
      "displayName": "Windows ARM64 static",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "win-arm64-shared",
      "inherits": "win-arm64-base",
      "displayName": "Windows ARM64 shared",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "win-x64-base",
      "hidden": true,
      "inherits": "win-base",
      "architecture": "x64"
    },
    {
      "name": "win-x64-static",
      "inherits": "win-x64-base",
      "displayName": "Windows x64 static",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "win-x64-shared",
      "inherits": "win-x64-base",
      "displayName": "Windows x64 shared",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "mac-arm64-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Xcode",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "mac-arm64-static",
      "inherits": "mac-arm64-base",
      "displayName": "macOS ARM64 static",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "mac-arm64-shared",
      "inherits": "mac-arm64-base",
      "displayName": "macOS ARM64 shared",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-arm64-static-debug",
      "configurePreset": "win-arm64-static",
      "configuration": "Debug"
    },
    {
      "name": "win-arm64-static-release",
      "configurePreset": "win-arm64-static",
      "configuration": "Release"
    },
    {
      "name": "win-arm64-shared-debug",
      "configurePreset": "win-arm64-shared",
      "configuration": "Debug"
    },
    {
      "name": "win-arm64-shared-release",
      "configurePreset": "win-arm64-shared",
      "configuration": "Release"
    },
    {
      "name": "win-x64-static-debug",
      "configurePreset": "win-x64-static",
      "configuration": "Debug"
    },
    {
      "name": "win-x64-static-release",
      "configurePreset": "win-x64-static",
      "configuration": "Release"
    },
    {
      "name": "win-x64-shared-debug",
      "configurePreset": "win-x64-shared",
      "configuration": "Debug"
    },
    {
      "name": "win-x64-shared-release",
      "configurePreset": "win-x64-shared",
      "configuration": "Release"
    },
    {
      "name": "mac-arm64-static-debug",
      "configurePreset": "mac-arm64-static",
      "configuration": "Debug"
    },
    {
      "name": "mac-arm64-static-release",
      "configurePreset": "mac-arm64-static",
      "configuration": "Release"
    },
    {
      "name": "mac-arm64-shared-debug",
      "configurePreset": "mac-arm64-shared",
      "configuration": "Debug"
    },
    {
      "name": "mac-arm64-shared-release",
      "configurePreset": "mac-arm64-shared",
      "configuration": "Release"
    }
  ]
}
