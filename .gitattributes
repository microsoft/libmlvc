# If you change something here, consider running `git add --renormalize .`
# https://adaptivepatchwork.com/2012/03/01/mind-the-end-of-your-line/
# https://stackoverflow.com/questions/35011366/move-git-lfs-tracked-files-under-regular-git/54119191#54119191
# https://www.git-scm.com/docs/gitattributes#_checking_out_and_checking_in
# https://code.visualstudio.com/docs/remote/troubleshooting#_resolving-git-line-ending-issues-in-containers-resulting-in-many-modified-files

# order of these lines is important.  this should be the first line.
* text=auto eol=lf

# Force bash scripts to always use lf line endings so that if a repo is accessed
# in Unix via a file share from Windows, the scripts will work.
*.sh text eol=lf

# Windows batch scripts
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf

# Windows executables
*.dll filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.msi -text

# Documents
*.docx -text
*.pdf -text
*.pptx filter=lfs diff=lfs merge=lfs -text

# https://docs.microsoft.com/en-us/cpp/build/profile-guided-optimizations
*.pgc filter=lfs diff=lfs merge=lfs -text
*.pgd filter=lfs diff=lfs merge=lfs -text
*.spd filter=lfs diff=lfs merge=lfs -text
*.spt filter=lfs diff=lfs merge=lfs -text

# https://wiki.multimedia.cx/index.php/IVF
*.ivf filter=lfs diff=lfs merge=lfs -text

# Data files
*.bin filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.mlvc filter=lfs diff=lfs merge=lfs -text
*.mlmodel filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
