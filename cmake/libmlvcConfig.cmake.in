@PACKAGE_INIT@
if(CMAKE_VERSION VERSION_LESS 3.30)
    set(libmlvc_FOUND FALSE)
    set(libmlvc_NOT_FOUND_MESSAGE "libmlvc requires CMake 3.30 or newer")
    return()
endif()

if(NOT "@BUILD_SHARED_LIBS@")
    include(CMakeFindDependencyMacro)
    find_dependency(
        Boost
        CONFIG
        REQUIRED
        COMPONENTS
        json
    )
endif()
include(${CMAKE_CURRENT_LIST_DIR}/libmlvcTargets.cmake)
check_required_components(libmlvc)
